# Site
SITE_URL=https://emruz.com
NEXT_PUBLIC_SITE_URL=https://emruz.com

# Database (Netlify Database sets NETLIFY_DB_URL automatically; DATABASE_URL overrides it)
# DATABASE_URL=postgres://...

# Motiv licensing: Ed25519 private key that signs leases (kid k1). Paste the PEM;
# literal \n line breaks are accepted.
MOTIV_LICENSE_PRIVATE_KEY=
MOTIV_LICENSE_KID=k1
# Show Buy buttons on /motiv (rebuild/redeploy after changing)
MOTIV_SALES_OPEN=false
# Optional overrides
# MOTIV_LEASE_DAYS=14
# MOTIV_PAST_DUE_GRACE_DAYS=7
# MOTIV_DEFAULT_SEATS=2

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
STRIPE_PRICE_LIFETIME=price_...

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=Emruz <no-reply@emruz.com>
EMAIL_REPLY_TO=contact@emruz.com

# Sign-in providers
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=com.emruz.web
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Comma-separated emails that can open /admin/motiv
ADMIN_EMAILS=
