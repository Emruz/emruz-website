# Site
SITE_URL=https://emruz.com
NEXT_PUBLIC_SITE_URL=https://emruz.com

# Database (Netlify Database sets NETLIFY_DB_URL automatically; DATABASE_URL overrides it)
# DATABASE_URL=postgres://...

# Motiv licensing: Ed25519 private key that signs leases (kid k1). Paste the PEM;
# literal \n line breaks are accepted.
MOTIV_LICENSE_PRIVATE_KEY=
MOTIV_LICENSE_KID=k1
# Show Buy buttons on /motiv (rebuild/redeploy after changing)
MOTIV_SALES_OPEN=false
# Show Buy buttons on /kits (#68; rebuild/redeploy after changing)
KITS_SALES_OPEN=false
# Founding lifetime offer on All kits ends after 152 buyers or on 2027-12-31.
# Optional: a different last day, YYYY-MM-DD (a past date ends it now)
# KITS_LIFETIME_UNTIL=2027-12-31
# Optional overrides
# MOTIV_LEASE_DAYS=14
# MOTIV_PAST_DUE_GRACE_DAYS=7
# MOTIV_DEFAULT_SEATS=2

# Emruz kits over MCP (docs/emruz-kits-mcp.md). Ed25519 key that signs MCP access
# tokens (not the Motiv key); literal \n line breaks are accepted. Mark it secret in Netlify.
MCP_TOKEN_PRIVATE_KEY=
MCP_TOKEN_KID=m1
# Fine-grained GitHub token, Emruz/emruz-kits only, Contents read-only, with an expiry. Secret.
SKILLS_REPO=Emruz/emruz-kits
SKILLS_TOKEN=
# Optional: hold the site at one release tag. Empty follows the latest published release.
# SKILLS_REF=v2026.11.5

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
STRIPE_PRICE_LIFETIME=price_...
# Stripe Tax can't be activated in a sandbox: set to false there, remove for live
# STRIPE_AUTOMATIC_TAX=false

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=Emruz <no-reply@emruz.com>
EMAIL_REPLY_TO=info@emruz.com

# Sign-in providers
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=com.emruz.web
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Comma-separated emails that can open /admin/motiv
ADMIN_EMAILS=
# Security alerts (webhook failures, sign-in failure spikes, rate-limit hits). Defaults to ADMIN_EMAILS.
ALERT_EMAILS=
