#!/usr/bin/env sh
# pre-commit from repo-pr-review: gitleaks on the staged changes.
# A finding, or gitleaks missing, stops the commit.
# Reviewed false positives go in .gitleaksignore (fingerprint) with a reason
# comment, as repo-ci-checks requires.
# Needs gitleaks 8.19 or later (the "git" command). Turned on by scripts/install-hooks.sh.
command -v gitleaks >/dev/null 2>&1 || {
  echo "pre-commit: gitleaks isn't installed, so staged changes can't be scanned for secrets." >&2
  echo "  macOS: brew install gitleaks   Linux: https://github.com/gitleaks/gitleaks/releases" >&2
  exit 1
}
# Exit 1 is a finding; any other non-zero exit is gitleaks itself failing.
gitleaks git --pre-commit --staged --redact --no-banner --log-level error --verbose --exit-code 1
rc=$?
[ "$rc" -eq 0 ] && exit 0
if [ "$rc" -eq 1 ]; then
  echo "pre-commit: gitleaks found a possible secret in the staged changes (file, line and rule above; the secret is redacted). Commit stopped." >&2
  echo "  Remove it and rotate it if it was real. A reviewed false positive goes in .gitleaksignore with a reason." >&2
else
  echo "pre-commit: gitleaks error (exit $rc), so the staged changes weren't scanned. Commit stopped." >&2
  echo "  Check the message above; gitleaks 8.19 or later is needed (gitleaks version)." >&2
fi
exit 1
