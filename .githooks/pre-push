#!/usr/bin/env sh
# pre-push from repo-pr-review: no pushes to the protected branches (which also
# blocks force pushes and deletion there). Changes reach main only through a pull
# request merged on GitHub. Feature branches can be force pushed, so a stacked
# branch rebased after a squash merge can still be shipped (ship.sh uses
# --force-with-lease). Turned on by scripts/install-hooks.sh.
#
# Git passes one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
PROTECTED="${PROTECTED_BRANCHES:-main master}"
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$remote_ref" ] || continue
  branch="${remote_ref#refs/heads/}"
  for p in $PROTECTED; do
    if [ "$branch" = "$p" ]; then
      echo "pre-push: refusing to push to $p. Open a pull request; rollbacks go through a revert branch and a PR." >&2
      fail=1
    fi
  done
done

exit "$fail"
